{
    "$schema": "../../tribes.schema.json",
    "id": "eof:mudwing",
    // Would be real nice if this could be a JSON object/array too
    "display_name": "MudWing",
    "attributes": [
        {
            "attribute_type": "potion",
            "potion_effect": { "id": "minecraft:strength", "amplifier": 1 }
        },
        {
            "attribute_type": "potion",
            "potion_effect": "minecraft:speed",
            "predicates": [
                { "predicate_type": "state", "state": "is_under_water" }
            ]
        },
        {
            "attribute_type": "potion",
            "potion_effect": "minecraft:water_breathing",
            "duration": {
                "amount": 150,
                "unit": "seconds"
            },
            "predicates": [
                { "predicate_type": "state", "state": "is_under_water" }
            ]
        }
    ],
    "active_abilities": [
        {
            "use": "eof:flame_breath"
            // "overrides": {}
        }
    ],
    "passive_abilities": []
}
