{
    "$schema": "../../active_ability.schema.json",
    "id": "eof:tidal_wave",
    "display_name": { "text": "Tidal Wave", "color": "aqua" },
    "item": "minecraft:gray_dye",
    "cooldown": 10,
    "data": {
        // count: integer >0 is deferred
        // spread: number >0 is deferred
        // arc: number >0 is deferred
        "duration": 4,
        "range": 10,
        "target": "raycast",
        "effects": {
            "sneak_use": [
                { "effect_type": "elytrasoffire:damage", "damage": 2 },
                {
                    "effect_type": "elytrasoffire:potion",
                    "potion_effect": "minecraft:mining_fatigue"
                },
                {
                    "effect_type": "elytrasoffire:potion",
                    "potion_effect": "minecraft:slowness"
                }
                // Torrent I and II apply Poison II for 3s and IV for 3s respectively, but that's a conditional i don't feel like writing.
            ]
        }
    }
}
