{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["attribute_type"],
    "allOf": [
        {
            "if": { "properties": { "attribute_type": { "const": "potion" } } },
            "then": { "required": ["potion_effect"] },
            "else": { "not": { "required": ["potion_effect"] } }
        }
    ],
    "properties": {
        "attribute_type": {
            "description": "The type of attribute to apply.",
            "type": "string",
            "enum": ["potion", "modifier"]
        },
        "potion_effect": {
            "description": "The potion effect to apply.",
            "$ref": "./effect.schema.json#/$defs/potion_effect"
        },
        "duration": {
            "description": "The amount of time the effect is applied for. If this is a number, it represents the amount of seconds.",
            "$ref": "./_common/duration.schema.json"
        },
        "predicates": {
            "description": "A predicate or list of predicates that must be met to activate the attribute.",
            "$ref": "./predicate.schema.json"
        }
    }
}
