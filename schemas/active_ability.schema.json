{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "display_name", "activation_inputs", "data", "cooldown"],
    "properties": {
        "$schema": true,
        "id": {
            "description": "The active ability's ID. Must be a namespaced string.",
            "$ref": "./_common/_strings.json#/$defs/namespace"
        },
        "display_name": {
            "description": "The display name of the active ability.",
            "$ref": "#/$defs/display_name"
        },
        "item": {
            "description": "The physical item used to represent the ability in players' inventories.",
            "default": "minecraft:gray_dye",
            "$ref": "./_common/_strings.json#/$defs/minecraft_namespace"
        },
        "activation_inputs": {
            "description": "The inputs required to activate the active ability.",
            "type": "array",
            "uniqueItems": true,
            "default": ["sneak", "use"],
            "items": { "$ref": "./predicate.schema.json#/$defs/action" }
        },
        "cooldown": {
            "description": "The amount of time it takes for the ability to come off cooldown.",
            "default": 10,
            "$ref": "./_common/ticks_or_seconds.json"
        },
        "data": {
            "description": "The activation's data.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "range": {
                    "description": "The distance the raycast will travel in blocks.",
                    "type": "number",
                    "minimum": 0,
                    "default": 10
                },
                "effects": {
                    "description": "An effect or array of effects to apply.",
                    "type": "object",
                    "additionalProperties": false,
                    "patternProperties": {
                        "^attack|climb|fly|glide|sneak|sprint|swim|use$": {}
                    }
                }
            }
        }
    },
    "$defs": {
        "display_name": {
            "anyOf": [
                {
                    "$ref": "./_common/_strings.json#/$defs/natural_case"
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["text"],
                    "default": {
                        "text": "Display Name",
                        "color": "white"
                    },
                    "properties": {
                        "text": {
                            "$ref": "./_common/_strings.json#/$defs/natural_case"
                        },
                        "color": {
                            "anyOf": [
                                {
                                    "$ref": "./_common/_strings.json#/$defs/hex_code"
                                },
                                {
                                    "type": "string",
                                    "enum": [
                                        "aqua",
                                        "black",
                                        "blue",
                                        "dark_aqua",
                                        "dark_blue",
                                        "dark_gray",
                                        "dark_green",
                                        "dark_purple",
                                        "dark_red",
                                        "gold",
                                        "gray",
                                        "green",
                                        "light_purple",
                                        "red",
                                        "white",
                                        "yellow"
                                    ]
                                }
                            ]
                        }
                    }
                }
            ]
        }
    }
}
