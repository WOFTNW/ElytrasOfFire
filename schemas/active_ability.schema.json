{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "anyOf": [
        {
            "required": [
                "id",
                "display_name",
                "activation_inputs",
                "activation_type",
                "cooldown"
            ]
        },
        {
            "required": ["use"]
        }
    ],
    "allOf": [
        {
            "if": {
                "properties": { "activation_type": { "const": "raycast" } }
            },
            "then": { "required": ["raycast_data"] },
            "else": { "not": { "required": ["raycast_data"] } }
        }
    ],
    "properties": {
        "$schema": true,
        "id": {
            "description": "The active ability's ID. Must be a namespaced string.",
            "$ref": "./_common/_strings.json#/$defs/namespace"
        },
        "display_name": {
            "description": "The display name of the active ability.",
            "$ref": "#/$defs/display_name"
        },
        "ability_item": {
            "description": "The physical item used to represent the ability in players' inventories.",
            "pattern": "^minecraft:[^:0-9A-Z\\s]+$",
            "$ref": "./_common/_strings.json#/$defs/namespace"
        },
        "activation_inputs": {
            "description": "The inputs required to activate the active ability.",
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "./predicate.schema.json#/$defs/action" }
        },
        "activation_type": {
            "description": "The type of activation this ability emits.",
            "type": "string",
            "default": "self",
            "enum": ["raycast", "aura", "self", "target", "nearest"],
            "$comment": "'raycast' is... a raycast and will require 'raycast_data'; 'aura' is a spherical emanation and will require 'radius' (or... i guess just 'range' since it represents the same idea); 'self' will only affect the user; and 'nearest' will require 'count', which represents targeting the x nearest valid entities with the ability."
        },
        "cooldown": {
            "description": "The amount of time it takes for the ability to come off cooldown.",
            "default": 10,
            "type": "number",
            "minimum": 0
        },
        "raycast_data": {
            "description": "The raycast data.",
            "type": "object",
            "additionalProperties": false,
            "required": ["range"],
            "properties": {
                "range": {
                    "description": "The distance the raycast will travel in blocks.",
                    "type": "number",
                    "minimum": 0,
                    "default": 10
                },
                "effects": {
                    "description": "An effect or array of effects to apply.",
                    "$ref": "./effect.schema.json"
                }
            }
        },
        "use": {
            "type": "string"
        }
    },
    "$defs": {
        "display_name": {
            "anyOf": [
                {
                    "$ref": "./_common/_strings.json#/$defs/natural_case"
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["text"],
                    "default": {
                        "text": "Display Name",
                        "color": "white"
                    },
                    "properties": {
                        "text": {
                            "$ref": "./_common/_strings.json#/$defs/natural_case"
                        },
                        "color": {
                            "anyOf": [
                                {
                                    "$ref": "./_common/_strings.json#/$defs/hex_code"
                                },
                                {
                                    "type": "string",
                                    "enum": [
                                        "aqua",
                                        "black",
                                        "blue",
                                        "dark_aqua",
                                        "dark_blue",
                                        "dark_gray",
                                        "dark_green",
                                        "dark_purple",
                                        "dark_red",
                                        "gold",
                                        "gray",
                                        "green",
                                        "light_purple",
                                        "red",
                                        "white",
                                        "yellow"
                                    ]
                                }
                            ]
                        }
                    }
                }
            ]
        }
    }
}
