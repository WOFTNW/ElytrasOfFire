{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "anyOf": [
        { "$ref": "#/$defs/predicate" },
        {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/predicate" }
        }
    ],
    "$defs": {
        "predicate": {
            "type": "object",
            "additionalProperties": false,
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "predicate_type": { "const": "action" }
                        }
                    },
                    "then": { "required": ["action"] },
                    "else": { "not": { "required": ["action"] } }
                },
                {
                    "if": {
                        "properties": {
                            "predicate_type": { "const": "location" }
                        }
                    },
                    "then": { "required": ["location"] },
                    "else": { "not": { "required": ["location"] } }
                },
                {
                    "if": {
                        "properties": {
                            "predicate_type": { "const": "state" }
                        }
                    },
                    "then": { "required": ["state"] },
                    "else": { "not": { "required": ["state"] } }
                }
            ],
            "properties": {
                "predicate_type": { "$ref": "#/$defs/predicate_type" },
                "action": { "$ref": "#/$defs/action" },
                "location": { "$ref": "#/$defs/location" },
                "state": { "$ref": "#/$defs/state" },
                "time": { "$ref": "#/$defs/time" },
                "blocks": { "$ref": "#/$defs/blocks" }
            }
        },
        "predicate_type": {
            "type": "string",
            "enum": ["action", "location", "state", "time"]
        },
        "action": {
            "description": "An action input.",
            "type": "string",
            "enum": [
                "attack",
                "climb",
                "fly",
                "glide",
                "sneak",
                "sprint",
                "swim",
                "use"
            ]
        },
        "location": {
            "description": "A location.",
            "type": "string",
            "enum": ["on_blocks", "in_blocks"]
        },
        "state": {
            "description": "A state.",
            "type": "string",
            "enum": [
                "is_falling",
                "is_flying",
                "is_gliding",
                "is_on_fire",
                "is_swimming",
                "is_in_water",
                "is_under_water"
            ]
        },
        "time": {
            "description": "A time of day. May be a single number or an object with a minimum and maximum time span.",
            "anyOf": [
                { "$ref": "#/$defs/time_single" },
                { "$ref": "#/$defs/time_range" }
            ]
        },
        "time_range": {
            "$comment": "JUST BEING TRANSPARENT, this does NO validation on whether the 'min' value is actually smaller than the 'max' value",
            "type": "object",
            "additionalProperties": false,
            "required": ["min", "max"],
            "properties": {
                "min": { "$ref": "#/$defs/time_single" },
                "max": { "$ref": "#/$defs/time_single" }
            }
        },
        "time_single": {
            "anyOf": [
                {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 23999
                },
                {
                    "type": "string",
                    "enum": [
                        "dawn",
                        "day",
                        "midday",
                        "dusk",
                        "night",
                        "midnight"
                    ]
                }
            ]
        },
        "blocks": { "description": "A list of blocks or block tags." }
    }
}
