{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "anyOf": [
        { "$ref": "#/$defs/effect" },
        {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/effect" }
        }
    ],
    "$defs": {
        "effect": {
            "type": "object",
            "additionalProperties": false,
            "required": ["effect_type"],
            "allOf": [
                {
                    "if": {
                        "properties": { "effect_type": { "const": "damage" } }
                    },
                    "then": {
                        "allOf": [
                            { "required": ["damage"] },
                            { "not": { "required": ["duration"] } }
                        ]
                    },
                    "else": { "not": { "required": ["damage"] } }
                },
                {
                    "if": {
                        "properties": { "effect_type": { "const": "potion" } }
                    },
                    "then": { "required": ["potion_effect"] },
                    "else": { "not": { "required": ["potion_effect"] } }
                },
                {
                    "if": {
                        "properties": {
                            "effect_type": { "pattern": "ignite|potion" }
                        }
                    },
                    "then": { "required": ["duration"] },
                    "else": { "not": { "required": ["duration"] } }
                },
                {
                    "if": {
                        "properties": {
                            "effect_type": { "pattern": "data" }
                        }
                    },
                    "then": {
                        "anyOf": [
                            { "required": ["apply_data"] },
                            { "required": ["remove_data"] }
                        ]
                    },
                    "else": {
                        "not": {
                            "anyOf": [
                                { "required": ["apply_data"] },
                                { "required": ["remove_data"] }
                            ]
                        }
                    }
                }
            ],
            "properties": {
                "effect_type": {
                    "type": "string",
                    "$comment": "data requires one or both of 'apply_data' and 'remove_data'",
                    "enum": ["ignite", "potion", "data", "damage"]
                },
                "duration": {
                    "description": "The amount of time the effect is applied for. If this is a number, it represents the amount of seconds.",
                    "$ref": "./_common/duration.schema.json"
                },
                "potion_effect": {
                    "description": "The potion effect to apply.",
                    "$ref": "#/$defs/potion_effect"
                },
                "target": {
                    "description": "The target of this effect.",
                    "type": "string",
                    "enum": ["all", "others", "raycast", "self", "melee"]
                },
                "damage": {
                    "description": "The amount of damage to deal to the target(s).",
                    "type": "number",
                    "exclusiveMinimum": 0
                },
                "apply_data": {
                    "description": "The custom data to apply to the target(s). Must be a namespaced string.",
                    "$ref": "./_common/_strings.json#/$defs/namespace"
                },
                "remove_data": {
                    "description": "The custom data to remove from the target(s). Must be a namespaced string.",
                    "$ref": "./_common/_strings.json#/$defs/namespace"
                }
            }
        },
        "potion_effect": {
            "description": "A string or object representing a potion effect. If listed as a string, amplifier is assumed to be 0.",
            "anyOf": [
                { "$ref": "#/$defs/potion_effect_string" },
                { "$ref": "#/$defs/potion_effect_object" }
            ]
        },
        "potion_effect_string": {
            "description": "A string representation of a potion effect. When used, amplifier is assumed to be 0.",
            "type": "string",
            "enum": [
                "minecraft:absorption",
                "minecraft:bad_omen",
                "minecraft:blindness",
                "minecraft:breath_of_the_nautilus",
                "minecraft:conduit_power",
                "minecraft:darkness",
                "minecraft:dolphins_grace",
                "minecraft:fire_resistance",
                "minecraft:freezing",
                "minecraft:glowing",
                "minecraft:haste",
                "minecraft:health_boost",
                "minecraft:hero_of_the_village",
                "minecraft:hunger",
                "minecraft:infested",
                "minecraft:instant_damage",
                "minecraft:instant_health",
                "minecraft:invisibility",
                "minecraft:jump_boost",
                "minecraft:levitation",
                "minecraft:luck",
                "minecraft:mining_fatigue",
                "minecraft:nausea",
                "minecraft:night_vision",
                "minecraft:oozing",
                "minecraft:poison",
                "minecraft:raid_omen",
                "minecraft:regeneration",
                "minecraft:resistance",
                "minecraft:saturation",
                "minecraft:slow_falling",
                "minecraft:slowness",
                "minecraft:speed",
                "minecraft:strength",
                "minecraft:trial_omen",
                "minecraft:unluck",
                "minecraft:water_breathing",
                "minecraft:weakness",
                "minecraft:weaving",
                "minecraft:wind_charged",
                "minecraft:wither"
            ],
            "pattern": "^minecraft:[^:0-9A-Z]+$",
            "$ref": "./_common/_strings.json#/$defs/namespace"
        },
        "potion_effect_object": {
            "description": "An object representation of a potion effect.",
            "type": "object",
            "additionalProperties": false,
            "required": ["id"],
            "properties": {
                "id": { "$ref": "#/$defs/potion_effect_string" },
                "amplifier": {
                    "description": "The amplifier of the potion effect.",
                    "$ref": "./_common/_numbers.json#/$defs/nonnegative_int"
                }
            }
        }
    }
}
