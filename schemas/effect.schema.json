{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "anyOf": [
        { "$ref": "#/$defs/effect" },
        {
            "type": "array",
            "uniqueItems": true,
            "items": {
                "description": "A single effect.",
                "$ref": "#/$defs/effect"
            }
        }
    ],
    "$defs": {
        "effect": {
            "type": "object",
            "additionalProperties": false,
            "required": ["effect_type"],
            "allOf": [
                {
                    "if": {
                        "properties": { "effect_type": { "const": "elytrasoffire:damage" } }
                    },
                    "then": {
                        "allOf": [
                            { "required": ["damage"] },
                            { "not": { "required": ["duration"] } }
                        ]
                    },
                    "else": { "not": { "required": ["damage"] } }
                },
                {
                    "if": {
                        "properties": { "effect_type": { "const": "elytrasoffire:potion" } }
                    },
                    "then": { "required": ["potion_effect"] },
                    "else": { "not": { "required": ["potion_effect"] } }
                },
                {
                    "if": {
                        "properties": {
                            "effect_type": { "pattern": "elytrasoffire:(?:ignite|potion)" }
                        }
                    },
                    "then": { "required": ["duration"] },
                    "else": { "not": { "required": ["duration"] } }
                },
                {
                    "if": {
                        "properties": {
                            "effect_type": { "pattern": "elytrasoffire:data" }
                        }
                    },
                    "then": {
                        "anyOf": [
                            { "required": ["apply_data"] },
                            { "required": ["remove_data"] }
                        ]
                    },
                    "else": {
                        "not": {
                            "anyOf": [
                                { "required": ["apply_data"] },
                                { "required": ["remove_data"] }
                            ]
                        }
                    }
                }
            ],
            "properties": {
                "effect_type": {
                    "description": "The type of effect this ability has.",
                    "enum": [
                        "elytrasoffire:damage",
                        "elytrasoffire:data",
                        "elytrasoffire:ignite",
                        "elytrasoffire:potion",
                        "elytrasoffire:switch_form",
                        "elytrasoffire:toggle"
                    ],
                    "$ref": "./_common/_strings.json#/$defs/namespace"
                },
                "duration": {
                    "description": "The amount of time the effect is applied for. If this is a number, it represents the amount of seconds.",
                    "$ref": "./_common/duration.schema.json"
                },
                "potion_effect": {
                    "description": "The potion effect(s) to apply.",
                    "anyOf": [
                        {
                            "$ref": "./_common/potion.schema.json#/$defs/potion_effect"
                        },
                        {
                            "type": "array",
                            "uniqueItems": true,
                            "minItems": 1,
                            "items": {
                                "$ref": "./_common/potion.schema.json#/$defs/potion_effect"
                            }
                        }
                    ]
                },
                "target": {
                    "description": "The target of this effect.",
                    "type": "string",
                    "enum": ["all", "others", "raycast", "self", "melee"]
                },
                "damage": {
                    "description": "The amount of damage to deal to the target(s).",
                    "type": "number",
                    "exclusiveMinimum": 0
                },
                "apply_data": {
                    "description": "The custom data to apply to the target(s). Must be a namespaced string.",
                    "$ref": "./_common/_strings.json#/$defs/namespace"
                },
                "remove_data": {
                    "description": "The custom data to remove from the target(s). Must be a namespaced string.",
                    "$ref": "./_common/_strings.json#/$defs/namespace"
                }
            }
        }
    }
}
